{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvoLiEZ V4 Seed Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "target_id",
    "source_runs",
    "candidates",
    "controls",
    "selection_policy"
  ],
  "properties": {
    "schema_version": {"const": 4.0},
    "target_id": {"type": "string"},
    "mechanism": {"type": "string"},
    "claim_level_default": {"const": "L0_uncalibrated"},
    "source_runs": {"type": "object"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "mutation",
          "role",
          "evidence_source",
          "evidence",
          "claim_level",
          "uncertainty_flags"
        ],
        "properties": {
          "candidate_id": {"type": "string"},
          "mutation": {"type": "string"},
          "role": {"type": "string"},
          "evidence_source": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "evidence": {"type": "object"},
          "claim_level": {"const": "L0_uncalibrated"},
          "uncertainty_flags": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "controls": {"type": "object"},
    "selection_policy": {
      "type": "object",
      "required": ["forbidden", "required_lanes"]
    }
  }
}
