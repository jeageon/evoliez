# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Pipeline run outputs (never commit large artifacts)
runs/
*.dcd
*.xtc
*.trr
*.h5

# Model weights / databases (fetched on the server, never committed)
weights/
databases/
*.pt
*.ckpt
*.pth
*.npz
# but DO track committed test fixtures (real tool-output samples)
!tests/fixtures/**

# Local config overrides
*.local.yaml

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# generated run reports (regenerable from io/*_report.py)
# ...but provenance records (runtime profiles, manifests) ARE version-controlled:
# they document a specific server run and are not regenerable. (V6 artifact policy)
# Use /reports/* (contents) not /reports/ (dir) so the subdir can be re-included.
/reports/*
!/reports/provenance/

# Paper data archive (generated by scripts/build_paper_archive.py, not source)
/fdh/

# session debugging/smoke scratch
scripts/_*
reports_out/

# Claude Code session/settings dir (large: transcripts + scratch)
.claude/
# scratch + downloaded papers
/tmp/
# regenerable v3 run reports (same policy as /reports/, runs/)
/reports_v3/

# CAR run artifacts (deliverable in GDrive; never commit)
car/results/
