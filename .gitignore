# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual environments (greedy: matches .venv/, .venv-light/, .venv-test/, ...)
.venv*/
venv*/
env/

# Pipeline run outputs (never commit large artifacts)
runs/
*.dcd
*.xtc
*.trr
*.h5

# Model weights / databases (fetched on the server, never committed)
weights/
databases/
*.pt
*.ckpt
*.pth
*.npz
# but DO track committed test fixtures (real tool-output samples)
!tests/fixtures/**

# Local config overrides
*.local.yaml

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
